<!doctype html>
<html>
  <head>
    <title>Onceler Secret</title>
    <style type="text/css">
    #secret {
      border: 1px solid #ccc;
      padding: 1em;
      display: table;
    }
    #copy-btn {
      background: none;
      border: 1px solid #ccc;
      border-radius: 4px;
      cursor: pointer;
      padding: 0.3em 0.4em;
      line-height: 0;
      vertical-align: middle;
      color: #444;
    }
    #copy-btn:hover { border-color: #888; }
    </style>
<%= erb :'partials/header' %>
  </head>
  <body>
    <%= erb :'partials/bodyheader' %>

    <h1>Onceler</h1>
    <h3>
      I will call you by Whisper-ma-Phone,<br/>
      for the secrets I tell you are for your ears alone.
    </h3>

    <pre id="secret"><%= escape @entry.content %></pre>
    <p><button type="button" id="copy-btn" title="Copy to clipboard">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
    </button></p>

<% if @entry.once? || @deleted %>
    <p>
      This secret will be gone forever when you refresh.
      It has already been deleted from the server.
    </p>
<% else %>
    <p>
      This is a multi-use secret.
      <form method="post" action="<%= @delete_link or raise 'delete_link' %>">
        <button type="submit">Delete</button>
      </form>
    </p>
<% end %>

    <p>
      This secret was created from
      <code><%= escape(@entry.remote_host || @entry.remote_ip) %></code>
      at <%= Time.at(@entry.created) %>
    </p>

    <p>
      <form><button formaction="../../">Share your own secret</button></form>
    </p>
    <script>
      var clipboardIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>';
      var checkIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      document.getElementById('copy-btn').addEventListener('click', function() {
        var btn = document.getElementById('copy-btn');
        navigator.clipboard.writeText(document.getElementById('secret').textContent)
          .then(function() {
            btn.innerHTML = checkIcon;
            setTimeout(function() { btn.innerHTML = clipboardIcon; }, 2000);
          });
      });
    </script>
  </body>
</html>
<% # vim: set ft=eruby sw=2 ts=2 tw=79: %>
